<script setup lang="ts">
import AppLayout from '@/layouts/AppLayout.vue';
import { type BreadcrumbItem, {{ model }} } from '@/types';
import { Head } from '@inertiajs/vue3';
import { Button } from '@/components/ui/button';
import { router } from '@inertiajs/vue3';

const breadcrumbs: BreadcrumbItem[] = [
    {
        title: 'Dashboard',
        href: '/dashboard',
    },
    {
        title: '{{ modelPluralCapitalized }}',
        href: '/{{ modelPlural }}',
    },
    {
        title: 'View',
        href: '/{{ modelPlural }}/show',
    },
];

const props = defineProps<{
    {{ modelVariable }}: {{ model }};
}>();

const handleEdit = () => {
    router.visit(route('{{ routeName }}.edit', props.{{ modelVariable }}.id));
};

const handleDelete = () => {
    if (confirm('Are you sure you want to delete this {{ model }}?')) {
        router.delete(route('{{ routeName }}.destroy', props.{{ modelVariable }}.id));
    }
};
</script>

<template>
    <Head title="{{ modelPluralCapitalized }}" />

    <AppLayout :breadcrumbs="breadcrumbs">
        <div class="flex h-full flex-1 flex-col gap-4 rounded-xl p-4">
            <div class="mb-6 flex items-center justify-between">
                <h2 class="text-2xl font-bold">{{ model }} Details</h2>
                <div class="space-x-2">
                    <Button @click="handleEdit">Edit</Button>
                    <Button @click="handleDelete" variant="destructive">Delete</Button>
                </div>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
{{ detailFields }}
            </div>
        </div>
    </AppLayout>
</template>
