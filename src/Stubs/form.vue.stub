<script setup lang="ts">
import { Button } from '@/components/ui/button';
import { FormControl, FormField, FormItem, FormLabel } from '@/components/ui/form';
import { Input } from '@/components/ui/input';
import { {{ model }} } from '@/types/{{ modelVariable }}';
import { useForm, router } from '@inertiajs/vue3';
import InputError from '@/components/InputError.vue';

const props = defineProps<{
    {{ modelVariable }}?: {{ model }};
}>();

const form = useForm({
{{ formFields }}
});

const onSubmit = () => {
    if (props.{{ modelVariable }}) {
        form.put(route('{{ routeName }}.update', props.{{ modelVariable }}.id));
    } else {
        form.post(route('{{ routeName }}.store'));
    }
};

const onCancel = () => {
    router.visit(route('{{ routeName }}.index'));
};

const onDelete = () => {
    if (confirm('Are you sure you want to delete this {{ model }}?')) {
        router.delete(route('{{ routeName }}.destroy', props.{{ modelVariable }}?.id));
    }
};
</script>

<template>
    <form class="w-full max-w-2xl space-y-6" @submit.prevent="onSubmit">
        <div class="mb-6 flex items-center justify-between">
            <h2 class="text-2xl font-bold">
                {{ props.{{ modelVariable }} ? 'Edit {{ model }}' : 'Create {{ model }}' }}
            </h2>
            <div class="space-x-2">
                <Button v-if="props.{{ modelVariable }}" type="button" variant="destructive" @click="onDelete"> Delete</Button>
            </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
{{ formInputs }}
        </div>

        <div class="flex items-center justify-end space-x-4 pt-4">
            <Button type="button" variant="outline" :disabled="form.processing" @click="onCancel"> Cancel</Button>
            <Button type="submit" :disabled="form.processing">
                <span v-if="form.processing">
                    {{ props.{{ modelVariable }} ? 'Updating...' : 'Creating...' }}
                </span>
                <span v-else>
                    {{ props.{{ modelVariable }} ? 'Update {{ model }}' : 'Create {{ model }}' }}
                </span>
            </Button>
        </div>
    </form>
</template>
